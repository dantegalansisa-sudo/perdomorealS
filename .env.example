# Public site URL (no trailing slash). Used for canonical, hreflang, sitemap and OG.
NEXT_PUBLIC_SITE_URL=https://www.perdomorealestate.com

# Supabase (Project Settings → API). Without these, the site runs on the bundled seed data
# and the admin panel shows a setup notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to insert leads, run the seed script and admin uploads. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (lead notifications)
RESEND_API_KEY=
LEADS_NOTIFY_TO=ventas@perdomorealestate.com
LEADS_NOTIFY_FROM="Perdomo Real Estate <leads@perdomorealestate.com>"

# Optional Cloudflare Turnstile (anti-spam). Leave empty to use honeypot + rate limit only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt for hashing visitor IPs in the rate limiter
IP_HASH_SALT=change-me
